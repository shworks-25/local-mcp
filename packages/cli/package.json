{
  "name": "@shworks/local-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "CLI for shworks-devkit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shworks-25/local-mcp.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/shworks-25/local-mcp#readme",
  "bugs": {
    "url": "https://github.com/shworks-25/local-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cli",
    "developer-tools"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shcli": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@shworks/local-core": "workspace:*",
    "@shworks/local-mcp": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  }
}
