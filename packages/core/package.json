{
  "name": "@shworks/local-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Core library for shworks-devkit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shworks-25/local-mcp.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/shworks-25/local-mcp#readme",
  "bugs": {
    "url": "https://github.com/shworks-25/local-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "pino": "^10.3.1",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ssh2": "^1.15.5",
    "typescript": "^7.0.2"
  }
}
