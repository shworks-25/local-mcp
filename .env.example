# 服务绑定地址与端口
MCP_HOST=127.0.0.1
MCP_PORT=8787

# 鉴权 Token（生产或公网访问建议配置强随机密钥）
# 推荐生成命令（生成 32 字节高强度十六进制随机密钥）：
#   方式 A (OpenSSL)：openssl rand -hex 32
#   方式 B (Node.js)：node -e "console.log(crypto.randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=your-random-token-here

# 受信任的主机名白名单（支持公网网关、自定义域名反代访问，多个域名以英文逗号分隔）
# 示例：MCP_ALLOWED_HOSTS=shworks.cn
MCP_ALLOWED_HOSTS=localhost

# 运行环境模式：可选 development | production | test
# - development：本地开发调试模式，未配置 Token 时允许降级启动
# - production：生产与公网部署模式，强制校验 MCP_AUTH_TOKEN，未配置时拦截启动
# - test：自动化测试模式，用于单测执行与环境透传
NODE_ENV=development

# 日志输出级别：可选 trace | debug | info | warn | error
# 设置为 debug 级别可打印工具调用的入参快照与详细追踪信息
SHDEV_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# SSH MCP
# -----------------------------------------------------------------------------
# SSH connection profile 定义在项目 `.devmcp.yaml` 中。
# profile 只保存环境变量名称，local-mcp 建立连接时才读取真实值；密码和私钥
# passphrase 不应直接写入 `.devmcp.yaml` 或提交到 Git。
#
# 密码认证示例：
# ssh:
#   connections:
#     production:
#       host: server.example.com
#       port: 22
#       usernameEnv: SSH_PROD_USER
#       auth:
#         type: password
#         passwordEnv: SSH_PROD_PASSWORD
#       # 必须固定服务端 host key，禁止自动信任未知服务器。
#       hostKeyFingerprint: SHA256:REPLACE_WITH_REAL_SERVER_FINGERPRINT
#       # ssh_exec 只能运行这里明确允许的远程程序。
#       allowedPrograms:
#         - systemctl
#         - journalctl
#
# 私钥认证示例：
# ssh:
#   connections:
#     production-key:
#       host: server.example.com
#       port: 22
#       usernameEnv: SSH_PROD_USER
#       auth:
#         type: private-key
#         privateKeyPath: ~/.ssh/id_ed25519
#         # 私钥未加密时可以省略 passphraseEnv。
#         passphraseEnv: SSH_PROD_KEY_PASSPHRASE
#       hostKeyFingerprint: SHA256:REPLACE_WITH_REAL_SERVER_FINGERPRINT
#       allowedPrograms:
#         - systemctl

# SSH 登录用户名。用户名通常不属于 secret；也可以直接在 `.devmcp.yaml`
# 使用 `username: deploy`，此时无需 usernameEnv 和本变量。
SSH_PROD_USER=deploy

# SSH 密码认证使用的密码。仅用于 auth.type=password。
# 请只在本机 `.env` 中替换为真实密码；模板中始终保留占位值。
SSH_PROD_PASSWORD=replace-me

# 加密 SSH 私钥的 passphrase。仅在私钥本身有 passphrase 时需要。
SSH_PROD_KEY_PASSPHRASE=replace-me

# -----------------------------------------------------------------------------
# Database MCP（预留）
# -----------------------------------------------------------------------------
# Database MCP 将在 SSH MCP 验证完成后实施。这里仅预留凭据命名约定；后续
# MySQL/PostgreSQL Driver 会采用与 SSH 相同的 Env Reference 机制，避免数据库
# 密码进入 `.devmcp.yaml`。

# MySQL 示例凭据。生产环境建议使用权限受限的只读数据库账号。
MYSQL_DEV_USER=app_readonly
MYSQL_DEV_PASSWORD=replace-me

# PostgreSQL 示例凭据，供后续 PostgreSQL Driver 使用。
POSTGRES_DEV_USER=app_readonly
POSTGRES_DEV_PASSWORD=replace-me
